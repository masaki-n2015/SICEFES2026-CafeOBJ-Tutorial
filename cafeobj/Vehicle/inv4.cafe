--> inv4 / enter: inv4 / enter: inv4: c-enter :true, p1 = q
open VEHICLE-PROOF-ENV .
  op p1 : -> Pid .
  eq loc(p1,s) = start .
  eq (x(last(ps(s)),s) > 0) = true .
  eq s' = enter(p1,s) .
  eq (p1 = q') = false .
  eq p1 = q .
  eq loc(q,s) = start .
  eq (q' = q) = false .
  eq ps(s) = (q' qs') .
  eq (x(q',s) > 0) = true .
  eq (((q q') qs') sub qs') = true .
  red istep4(q,q',qs') .
close

