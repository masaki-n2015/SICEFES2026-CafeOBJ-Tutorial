--> inv4 / enter: inv4 / enter: inv4: c-enter :true, p1 = q
open VEHICLE-PROOF-ENV .
  op p1 : -> Pid .
  eq loc(p1,s) = start .
  eq (x(last(ps(s)),s) > 0) = true .
  eq s' = enter(p1,s) .
  eq (p1 = q') = false .
  eq p1 = q .
  eq loc(q,s) = start .
  eq (q' = q) = false .
  eq ps(s) = (q' qs') .
  eq (x(q',s) > 0) = true .
  eq (((q q') qs') sub qs') = false .
  eq (x(q,s) < (x(q',s) + (-1/2 * (v(q,s) * v(q,s))))) = false .
  eq ((x(q,s) + (1/2 * (v(q,s) * v(q,s)))) >= x(q',s)) = true .
  ceq ((x(q,s) + (1/2 * (v(q,s) * v(q,s)))) > 0) = true if ((x(q,s) + (1/2 * (v(q,s) * v(q,s)))) >= x(q',s)) .
  ceq ((x(q,s) > (-1/2 * (v(q,s) * v(q,s))))) = true if ((x(q,s) + (1/2 * (v(q,s) * v(q,s)))) > 0) .
  ceq (x(q,s) > 0) = true if ((x(q,s) > (-1/2 * (v(q,s) * v(q,s))))) .
  ceq (x(q,s) = 0) = false if (x(q,s) > 0) .
  red (inv2(q,s) and inv5(q,s)) implies istep4(q,q',qs') .
close

