--> inv2 / enter: inv2 / enter: inv2: c-enter :true, p1 = q
open VEHICLE-PROOF-ENV .
  op p1 : -> Pid .
  eq loc(p1,s) = start .
  eq (x(last(ps(s)),s) > 0) = true .
  eq s' = enter(p1,s) .
  eq q = p1 .
  eq loc(q,s) = start .
  red istep2(q) .
close

