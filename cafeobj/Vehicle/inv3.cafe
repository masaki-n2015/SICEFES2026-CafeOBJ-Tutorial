--> inv3 / enter: inv3 / enter: inv3: c-enter :true, p1 = q
open VEHICLE-PROOF-ENV .
  op p1 : -> Pid .
  eq loc(p1,s) = start .
  eq (x(last(ps(s)),s) > 0) = true .
  eq s' = enter(p1,s) .
  eq q = p1 .
  eq loc(q,s) = start .
  eq x(q,s) = 0 .
  eq v(q,s) = 0 .
  eq x(p1,s) = 0 .
  eq v(p1,s) = 0 .
  red (inv2(q,s) and inv5(q,s)) implies istep3(q) .
close

--> inv3 / enter: inv3 / enter: inv3: c-enter :true, p1 =|= q'=|= q .
open VEHICLE-PROOF-ENV .
  op p1 : -> Pid .
  eq loc(p1,s) = start .
  eq (x(last(ps(s)),s) > 0) = true .
  eq s' = enter(p1,s) .
  eq (q = p1) = false .
  red istep3(q) .
close

--> inv3 / enter: c-enter true through ps(s) = nil, p1 = q
open VEHICLE-PROOF-ENV .
  op p1 : -> Pid .
  eq c-enter(p1,s) = true .
  eq ps(s) = nil .
  eq q = p1 .
  eq loc(q,s) = start .
  eq x(q,s) = 0 .
  eq v(q,s) = 0 .
  eq x(p1,s) = 0 .
  eq v(p1,s) = 0 .
  eq s' = enter(p1,s) .
  red (inv2(q,s) and inv5(q,s)) implies istep3(q) .
close

--> inv3 / enter: c-enter true through ps(s) = nil, p1 != q
