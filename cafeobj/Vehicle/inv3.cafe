--> inv3 / tick: c-tick true, q' is in ps(s)
open VEHICLE-PROOF-ENV .
  op t1 : -> Rat .
  eq c-tick(t1,s) = true .
  eq s' = tick(t1,s) .
  eq (q' in ps(s)) = true .
  eq c-tick(q',t1,s) = true .
  eq (0 <= v(q',s)) = true .
  eq (v(q',s) <= 4) = true .
  eq (0 <= nextv(q',t1,s)) = true .
  eq (nextv(q',t1,s) <= 4) = true .
  eq (0 <= (v(q',s) + ac(loc(q',s)) * t1)) = true .
  eq ((v(q',s) + ac(loc(q',s)) * t1) <= 4) = true .
  red inv3(q',s) implies istep3(q') .
close

--> inv3 / tick: c-tick true, q' is not in ps(s)
open VEHICLE-PROOF-ENV .
  op t1 : -> Rat .
  eq c-tick(t1,s) = true .
  eq s' = tick(t1,s) .
  eq (q' in ps(s)) = false .
  red istep3(q') .
close

--> inv3 / tick: inv3 / tick: c-tick = false
open VEHICLE-PROOF-ENV .
  op t1 : -> Rat .
  eq c-tick(t1,s) = false .
  eq s' = tick(t1,s) .
  red istep3(q') .
close
