--> inv3 / init: inv3 / init
open VEHICLE-PROOF-ENV .
  red inv3(q,init) .
close

--> inv3 / a: inv3 / a
open VEHICLE-PROOF-ENV .
  op t1 : -> Rat .
  op p1 : -> Pid .
  eq s' = a(p1,s) .
  eq c-a(p1,s) = true .
  eq q = p1 .
  red istep3(q) .
close

