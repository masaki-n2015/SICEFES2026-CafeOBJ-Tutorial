-- SICE FES 2026 Tutorial
-- ABCf / test.cafe
-- Executable examples for the ABCf specification.

in main.cafe

open INV .
  ops p1 p2 : -> Pid .
  ops s1 s2 s3 s4 : -> Sys .
  eq (p1 = p2) = false .
  eq s1 = ab(init,p1) .
  eq s2 = ab(s1,p2) .
  eq s3 = bc(s2,p1) .
  eq s4 = ab(s3,p2) .

  red loc(s1,p1) .
  red flag(s1) .
  red loc(s2,p2) .
  red loc(s4,p1) .
  red loc(s4,p2) .
  red flag(s4) .
  red inv1(s4,p1,p2) .
  red inv1(s4,p2,p2) .
close
