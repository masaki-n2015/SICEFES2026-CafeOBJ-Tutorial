--> inv1 / bc: inv1 / bc: inv1 bc ~c-bc
open INV .
  ops p1 p2 p3 : -> Pid .
  eq s' = bc(s,p3) .
  eq c-bc(s,p3) = false .
  red istep1(p1,p2) .
close

--> inv1 / bc: effective bc, p3 = p1
open INV .
  ops p1 p2 p3 : -> Pid .
  eq s' = bc(s,p3) .
  eq p3 = p1 .
  eq loc(s,p1) = b .
  red istep1(p1,p2) .
close

--> inv1 / bc: effective bc, p3 != p1, p3 = p2
open INV .
  ops p1 p2 p3 : -> Pid .
  eq s' = bc(s,p3) .
  eq (p3 = p1) = false .
  eq p3 = p2 .
  eq loc(s,p2) = b .
  red istep1(p1,p2) .
close

--> inv1 / bc: effective bc, p3 != p1, p3 != p2
open INV .
  ops p1 p2 p3 : -> Pid .
  eq s' = bc(s,p3) .
  eq (p3 = p1) = false .
  eq (p3 = p2) = false .
  eq loc(s,p3) = b .
  red inv1(s,p1,p2) implies istep1(p1,p2) .
close
