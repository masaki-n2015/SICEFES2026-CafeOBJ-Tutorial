--> inv4 / tick: inv4 / tick: bop tick : c-tick, loc(s,i) = c, (get(i,u(s)) < (now(s) + d2)
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  op d : -> Rat .
  eq ((now(s) + d) <= min(u(s))) = true .
  eq (0 <= d) = true .
  eq loc(s,i) = c .
  eq (get(i,u(s)) < (now(s) + d2)) = true .
  eq s' = tick(d,s) .
  red istep4(i) .
close

