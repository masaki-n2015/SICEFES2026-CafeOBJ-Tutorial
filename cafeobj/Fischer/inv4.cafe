-- Fischer / inv4.cafe
-- Complete Proof Score for invariant inv4.

in lemmas.cafe

--> inv4 / init: inv4 / init: init
open FISCHER-PROOF-ENV .
  ops i j : -> Pid .
  red inv4(init,i) .
close

--> inv4 / try: inv4 / try: bop try : c-try, i = j = k
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  eq loc(s,k) = a .
  eq i = k .
  eq j = k .
  eq s' = try(s,k) .
  red istep4(i) .
close

