-- SICE FES 2026 Tutorial
-- Fischer / lemmas.cafe
-- The participant-facing helper file keeps the proof environment thin.
-- The core specification and inv1--inv5/istep1--istep5 are in main.cafe;
-- auxiliary/pset-support.cafe records the proved arithmetic and PSet facts,
-- while auxiliary/fischer-wf.cafe supplies the representation invariant
-- needed by the passages that use wf-u.
in main.cafe
in auxiliary/pset-wf.cafe
in auxiliary/fischer-wf.cafe
in auxiliary/pset-support.cafe

mod FISCHER-PROOF-ENV {
  pr(ISTEP + FISCHER-WF + FISCHER-RAT-LEMMAS + PSET-LEMMAS)
}
