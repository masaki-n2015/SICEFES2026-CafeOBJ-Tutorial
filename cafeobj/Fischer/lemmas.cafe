-- SICE FES 2026 Tutorial
-- Fischer / lemmas.cafe
-- Proved low-level helper lemmata used by the invariant Proof Scores.

-- Low-level helper lemmata already established by the Proof Scores
-- in auxiliary/.  These are used by inv1.cafe through inv5.cafe.
-- PSET-LEMMAS is established by auxiliary/pset-lemmas.cafe.
in main.cafe

-- Exact arithmetic helper facts from the validated FINAL proof environment.
mod FISCHER-RAT-LEMMAS {
  pr(TIMEVAL)
  var A : Rat+
  vars B D : Rat
  var C : Rat+
  vars X Y Z : Rat
  ceq A < ((D + B) + C) = true if A < (B + C) and (0 <= D) .
  ceq (X + Y) < (Y + Z) = true if X < Z .
  ceq A < (B + (D + X)) = true if A < (B + X) and (0 <= D) .
}

-- Derived equations established by auxiliary/pset-lemmas.cafe.

mod PSET-LEMMAS {
  pr(PSET-WF)
  op wf-remove : Pid Pset -> Bool
  vars I J : Pid
  var D : Rat
  var PS : Pset
  eq wf-remove(I,PS) = (wf(PS) implies wf(remove(I,PS))) .
  ceq wf(remove(I,PS)) = true if wf(PS) .
  ceq get(I,remove(J,PS)) = get(I,PS)
    if wf(PS) and not(I = J) .
  ceq get(I,remove(I,PS)) = oo if wf(PS) .
  ceq D <= min(remove(I,PS)) = true
    if wf(PS) and D <= min(PS) .
  ceq D <= get(I,PS) = true
    if wf(PS) and D <= min(PS) .
}

-- Proof environment: the specification/istep modules plus proved PSET facts.
mod FISCHER-PROOF-ENV {
  pr(ISTEP + FISCHER-RAT-LEMMAS + PSET-LEMMAS)
}
