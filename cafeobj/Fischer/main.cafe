-- SICE FES 2026 Tutorial
-- Fischer / main.cafe
-- Complete executable specification and invariant/induction-step definitions.

-- Fischer core data modules.  No derived PSET theorem is declared here.

mod! LOC {
  [ Loc ]
  ops a b c d cs e : -> Loc
  var L : Loc
  eq (L = L) = true .
  eq (a = b) = false . eq (a = c) = false .
  eq (a = d) = false . eq (a = cs) = false . eq (a = e) = false .
  eq (b = c) = false . eq (b = d) = false .
  eq (b = cs) = false . eq (b = e) = false .
  eq (c = d) = false . eq (c = cs) = false . eq (c = e) = false .
  eq (d = cs) = false . eq (d = e) = false . eq (cs = e) = false .
}

mod* PID { [ Pid ] }

mod! PID+ {
  ex(PID)
  [ Pid < Pid+ ]
  op nop : -> Pid+
  eq ((X:Pid) = nop) = false .
  eq ((Z:Pid+) = Z) = true .
}

mod* TIMEVAL {
  pr(RAT)
  [ Rat < Rat+ ]
  op oo : -> Rat+
  op _<_ : Rat+ Rat+ -> Bool
  op _<=_ : Rat+ Rat+ -> Bool
  op _+_ : Rat+ Rat+ -> Rat+
  op min : Rat+ Rat+ -> Rat+
  var X : Rat
  vars D0 D1 D2 D3 : Rat+
  eq X < oo = true . eq oo < X = false . eq oo < oo = false .
  eq X <= oo = true . eq D0 <= oo = true .
  eq oo <= X = false . eq oo <= oo = true .
  eq X + oo = oo . eq oo + X = oo . eq oo + oo = oo .
  ceq min(D1,D2) = D1 if D1 <= D2 .
  ceq min(D1,D2) = D2 if D2 <= D1 .
  eq D0 <= min(D1,D2) = ((D0 <= D1) and (D0 <= D2)) .
  ceq X <= (X + D1) = true if 0 < D1 .
  ceq X + D1 < X + D2 = true if D1 < D2 .
  ceq min(D1,X) < D2 = true if D1 < D2 .
  ceq ((D2 <= D3) and (D3 < D1)) = false if (D1 <= D2) = true .
}

mod PAIR {
  pr(PID+ + TIMEVAL)
  [ Pair ]
  op _|_ : Pid+ Rat+ -> Pair
}

mod PSET {
  pr(PAIR)
  [ Pair < Pset ]
  op _ _ : Pset Pset -> Pset {assoc}
  op min : Pset -> Rat+
  op remove : Pid+ Pset -> Pset
  op get : Pid+ Pset -> Rat+
  var PS : Pset
  var D : Rat+
  vars I J : Pid+
  eq min((I | D)) = D .
  eq min((I | D) PS) = min(D,min(PS)) .
  eq remove(I,(J | D)) =
    (if I = J then (nop | oo) else (J | D) fi) .
  eq remove(I,(J | D) PS) =
    (if I = J then remove(I,PS) else (J | D) remove(I,PS) fi) .
  eq get(I,(J | D)) = (if I = J then D else oo fi) .
  eq get(I,(J | D) PS) = (if I = J then D else get(I,PS) fi) .
}

mod* FISCHER {
  pr(LOC + TIMEVAL + PSET)
  *[ Sys ]*
  op init : -> Sys
  bop turn : Sys -> Pid+
  bop loc : Sys Pid -> Loc
  bop now : Sys -> Rat
  bop l : Sys Pid -> Rat
  bop u : Sys -> Pset
  bop ui : Sys Pid -> Rat+
  bop try : Sys Pid -> Sys
  bop test : Sys Pid -> Sys
  bop set : Sys Pid -> Sys
  bop check : Sys Pid -> Sys
  bop exit : Sys Pid -> Sys
  bop reset : Sys Pid -> Sys
  bop tick : Rat Sys -> Sys
  op d1 : -> Rat
  op d2 : -> Rat
  vars I J : Pid
  var S : Sys
  var D : Rat

  eq turn(init) = nop . eq loc(init,I) = a . eq now(init) = 0 .
  eq l(init,I) = 0 . eq u(init) = (nop | oo) .
  eq ui(S,I) = get(I,u(S)) .
  eq 0 < d1 = true . eq d1 < d2 = true . eq d2 < oo = true .

  op c-try : Sys Pid -> Bool
  eq c-try(S,I) = (loc(S,I) = a) .
  ceq loc(try(S,I),J) = (if I = J then b else loc(S,J) fi)
    if c-try(S,I) .
  eq now(try(S,I)) = now(S) . eq l(try(S,I),J) = l(S,J) .
  eq u(try(S,I)) = u(S) . eq turn(try(S,I)) = turn(S) .
  ceq try(S,I) = S if not c-try(S,I) .

  op c-test : Sys Pid -> Bool
  eq c-test(S,I) = (loc(S,I) = b and turn(S) = nop) .
  ceq loc(test(S,I),J) = (if I = J then c else loc(S,J) fi)
    if c-test(S,I) .
  eq now(test(S,I)) = now(S) . eq l(test(S,I),J) = l(S,J) .
  ceq u(test(S,I)) = (I | now(S) + d1) u(S) if c-test(S,I) .
  eq turn(test(S,I)) = turn(S) .
  ceq test(S,I) = S if not c-test(S,I) .

  op c-set : Sys Pid -> Bool
  eq c-set(S,I) = (loc(S,I) = c) .
  ceq loc(set(S,I),J) = (if I = J then d else loc(S,J) fi)
    if c-set(S,I) .
  eq now(set(S,I)) = now(S) .
  ceq l(set(S,I),J) = (if I = J then now(S) + d2 else l(S,J) fi)
    if c-set(S,I) .
  ceq u(set(S,I)) = remove(I,u(S)) if c-set(S,I) .
  ceq turn(set(S,I)) = I if c-set(S,I) .
  ceq set(S,I) = S if not c-set(S,I) .

  op c-check : Sys Pid -> Bool
  eq c-check(S,I) = (loc(S,I) = d and l(S,I) <= now(S)) .
  ceq loc(check(S,I),J) =
    (if I = J then (if turn(S) = I then cs else b fi)
     else loc(S,J) fi) if c-check(S,I) .
  eq now(check(S,I)) = now(S) .
  ceq l(check(S,I),J) = (if I = J then 0 else l(S,J) fi)
    if c-check(S,I) .
  eq u(check(S,I)) = u(S) . eq turn(check(S,I)) = turn(S) .
  ceq check(S,I) = S if not c-check(S,I) .

  op c-exit : Sys Pid -> Bool
  eq c-exit(S,I) = (loc(S,I) = cs) .
  ceq loc(exit(S,I),J) = (if I = J then e else loc(S,J) fi)
    if c-exit(S,I) .
  eq now(exit(S,I)) = now(S) . eq l(exit(S,I),J) = l(S,J) .
  eq u(exit(S,I)) = u(S) . eq turn(exit(S,I)) = turn(S) .
  ceq exit(S,I) = S if not c-exit(S,I) .

  op c-reset : Sys Pid -> Bool
  eq c-reset(S,I) = (loc(S,I) = e) .
  ceq loc(reset(S,I),J) = (if I = J then a else loc(S,J) fi)
    if c-reset(S,I) .
  eq now(reset(S,I)) = now(S) . eq l(reset(S,I),J) = l(S,J) .
  eq u(reset(S,I)) = u(S) .
  ceq turn(reset(S,I)) = nop if c-reset(S,I) .
  ceq reset(S,I) = S if not c-reset(S,I) .

  op c-tick : Rat Sys -> Bool
  eq c-tick(D,S) = (0 <= D) and (now(S) + D <= min(u(S))) .
  ceq now(tick(D,S)) = now(S) + D if c-tick(D,S) .
  eq loc(tick(D,S),I) = loc(S,I) . eq l(tick(D,S),I) = l(S,I) .
  eq u(tick(D,S)) = u(S) . eq turn(tick(D,S)) = turn(S) .
  ceq tick(D,S) = S if not c-tick(D,S) .
}

mod INV {
  pr(FISCHER)
  op inv1 : Sys Pid Pid -> Bool
  op inv2 : Sys Pid Pid -> Bool
  op inv3 : Sys Pid Pid -> Bool
  op inv4 : Sys Pid -> Bool
  op inv5 : Sys Pid -> Bool
  var S : Sys
  vars I J : Pid
  eq inv1(S,I,J) =
    (loc(S,I) = cs and loc(S,J) = cs implies I = J) .
  eq inv2(S,I,J) =
    ((loc(S,I) = cs or loc(S,I) = e) and not(I = J)
     implies turn(S) = I and not(loc(S,J) = c)) .
  eq inv3(S,I,J) =
    (loc(S,I) = d and turn(S) = I and loc(S,J) = c and not(I = J)
     implies get(J,u(S)) < l(S,I)) .
  eq inv4(S,I) =
    (loc(S,I) = c implies get(I,u(S)) < now(S) + d2) .
  eq inv5(S,I) = now(S) <= get(I,u(S)) .
}

mod ISTEP {
  pr(INV)
  ops s s' : -> Sys
  op istep1 : Pid Pid -> Bool
  op istep2 : Pid Pid -> Bool
  op istep3 : Pid Pid -> Bool
  op istep4 : Pid -> Bool
  op istep5 : Pid -> Bool
  vars I J : Pid
  eq istep1(I,J) = inv1(s,I,J) implies inv1(s',I,J) .
  eq istep2(I,J) = inv2(s,I,J) implies inv2(s',I,J) .
  eq istep3(I,J) = inv3(s,I,J) implies inv3(s',I,J) .
  eq istep4(I) = inv4(s,I) implies inv4(s',I) .
  eq istep5(I) = inv5(s,I) implies inv5(s',I) .
}
