-- SICE FES 2026 Tutorial
-- Fischer / auxiliary/wf-u.cafe
-- Complete Proof Score for preservation of the well-formed PSET representation.

in ../main.cafe
in pset-wf.cafe
in fischer-wf.cafe
in pset-support.cafe

mod FISCHER-WF-ISTEP {
  pr(FISCHER-WF + ISTEP)
  op wfstep : -> Bool
  eq wfstep = wf-u(s) implies wf-u(s') .
}

mod FISCHER-WF-PROOF-ENV {
  pr(FISCHER-WF-ISTEP + FISCHER-RAT-LEMMAS + PSET-LEMMAS)
}

--> wf-u / init
open FISCHER-WF-PROOF-ENV .
  red wf-u(init) .
close

--> wf-u / try
open FISCHER-WF-PROOF-ENV .
  op k : -> Pid .
  eq s' = try(s,k) .
  red wfstep .
close

--> wf-u / test: effective
open FISCHER-WF-PROOF-ENV .
  op k : -> Pid .
  eq s' = test(s,k) .
  eq c-test(s,k) = true .
  red wfstep .
close

--> wf-u / test: ineffective
open FISCHER-WF-PROOF-ENV .
  op k : -> Pid .
  eq s' = test(s,k) .
  eq c-test(s,k) = false .
  red wfstep .
close

--> wf-u / set: effective
open FISCHER-WF-PROOF-ENV .
  op k : -> Pid .
  eq s' = set(s,k) .
  eq c-set(s,k) = true .
  red wf-remove(k,u(s)) implies wfstep .
close

--> wf-u / set: ineffective
open FISCHER-WF-PROOF-ENV .
  op k : -> Pid .
  eq s' = set(s,k) .
  eq c-set(s,k) = false .
  red wfstep .
close

--> wf-u / check
open FISCHER-WF-PROOF-ENV .
  op k : -> Pid .
  eq s' = check(s,k) .
  red wfstep .
close

--> wf-u / exit
open FISCHER-WF-PROOF-ENV .
  op k : -> Pid .
  eq s' = exit(s,k) .
  red wfstep .
close

--> wf-u / reset
open FISCHER-WF-PROOF-ENV .
  op k : -> Pid .
  eq s' = reset(s,k) .
  red wfstep .
close

--> wf-u / tick
open FISCHER-WF-PROOF-ENV .
  op t : -> Rat .
  eq s' = tick(t,s) .
  red wfstep .
close
