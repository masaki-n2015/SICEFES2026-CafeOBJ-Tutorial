--> inv1 / tick: inv1 / tick: bop tick : Rat Sys -> Sys, c-tick
open FISCHER-PROOF-ENV .
  ops i j : -> Pid .
  op t : -> Rat .
  eq (now(s) + t <= min(u(s))) = true .
  eq (0 <= t) = true .
  eq s' = tick(t,s) .
  red istep1(i,j) .
close

--> inv1 / tick: inv1 / tick: bop tick : Rat Sys -> Sys, not c-tick
open FISCHER-PROOF-ENV .
  ops i j : -> Pid .
  op t : -> Rat .
  eq c-tick(t,s) = false .
  eq s' = tick(t,s) .
  red istep1(i,j) .
close
