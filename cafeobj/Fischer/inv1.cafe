--> inv1 / check: inv1 / check: bop check : Sys Pid -> Sys, c-check, i = j = k
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  eq loc(s,k) = d .
  eq (l(s,k) <= now(s)) = true .
  eq i = k .
  eq j = k .
  eq s' = check(s,k) .
  red istep1(i,j) .
close

--> inv1 / check: inv1 / check: bop check : Sys Pid -> Sys, c-check, i = k ,j != k, turn(s) = k
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  eq loc(s,k) = d .
  eq (l(s,k) <= now(s)) = true .
  eq i = k .
  eq (j = k) = false .
  eq turn(s) = k .
  eq s' = check(s,k) .
  red inv2(s,j,i) implies istep1(i,j) .
close

