-- SICE FES 2026 Tutorial
-- Fischer / inv1.cafe
-- Complete Proof Score for invariant inv1.

in lemmas.cafe

--> inv1 / init: inv1 / init: init
open FISCHER-PROOF-ENV .
  ops i j : -> Pid .
  red inv1(init,i,j) .
close

--> inv1 / try: inv1 / try: bop try : Sys Pid -> Sys, c-try, i = j = k
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  eq loc(s,k) = a .
  eq i = k .
  eq j = k .
  eq s' = try(s,k) .
  red istep1(i,j) .
close

