-- Fischer / inv3.cafe
-- Complete Proof Score for invariant inv3.

in lemmas.cafe

--> inv3 / init: inv3 / init: init
open FISCHER-PROOF-ENV .
  ops i j : -> Pid .
  red inv3(init,i,j) .
close

--> inv3 / try: inv3 / try: bop try : c-try, i = j = k
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  eq loc(s,k) = a .
  eq i = k .
  eq j = k .
  eq s' = try(s,k) .
  red istep3(i,j) .
close

--> inv3 / try: inv3 / try: bop try : c-try, i != k, j = k
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  eq loc(s,k) = a .
  eq (i = k) = false .
  eq j = k .
  eq s' = try(s,k) .
  red istep3(i,j) .
close

