--> inv3 / tick: inv3 / tick: bop tick : c-tick, loc(s,i) = d, turn(s) = i, loc(s,j) = c, i = j
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  op t : -> Rat .
  eq ((now(s) + t) <= min(u(s))) = true .
  eq (0 <= t) = true .
  eq loc(s,i) = d .
  eq turn(s) = i .
  eq loc(s,j) = c .
  eq i = j .
  eq s' = tick(t,s) .
  red istep3(i,j) .
close

