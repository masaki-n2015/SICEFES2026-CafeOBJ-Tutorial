--> inv2 / tick: inv2 / tick: bop tick : Rat Sys -> Sys, c-tick
open FISCHER-PROOF-ENV .
  ops i j : -> Pid .
  op t : -> Rat .
  eq ((now(s) + t) <= min(u(s))) = true .
  eq (0 <= t) = true .
  eq s' = tick(t,s) .
  red istep2(i,j) .
close

