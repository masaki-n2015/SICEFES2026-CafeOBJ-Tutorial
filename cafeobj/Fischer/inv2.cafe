in lemmas.cafe

--> inv2 / init: inv2 / init: init
open FISCHER-PROOF-ENV .
  ops i j : -> Pid .
  red inv2(init,i,j) .
close

--> inv2 / try: inv2 / try: bop try : Sys Pid -> Sys, c-try, i = j = k
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  eq loc(s,k) = a .
  eq i = k .
  eq j = k .
  eq s' = try(s,k) .
  red istep2(i,j) .
close

