--> inv5 / tick: inv5 / tick: bop tick : c-tick
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  op d : -> Rat .
  eq ((now(s) + d) <= min(u(s))) = true .
  eq (0 <= d) = true .
  eq s' = tick(d,s) .
  eq wf(u(s)) = true .
  red wf-u(s) implies istep5(i) .
close

