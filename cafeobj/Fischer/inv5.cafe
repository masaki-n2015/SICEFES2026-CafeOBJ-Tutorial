-- Fischer / inv5.cafe
-- Complete Proof Score for invariant inv5.

in lemmas.cafe

--> inv5 / init: inv5 / init: init
open FISCHER-PROOF-ENV .
  ops i j : -> Pid .
  red inv5(init,i) .
close

--> inv5 / try: inv5 / try: bop try : c-try
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  eq loc(s,k) = a .
  eq s' = try(s,k) .
  red istep5(i) .
close

--> inv5 / try: inv5 / try: bop try : not c-try
open FISCHER-PROOF-ENV .
  ops i j k : -> Pid .
  eq c-try(s,k) = false .
  eq s' = try(s,k) .
  red istep5(i) .
close

